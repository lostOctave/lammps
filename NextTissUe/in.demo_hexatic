# NextTissUe simulation using pre-generated hexatic lattice initial configuration
# Uses initial_cells.data generated by generate_nexttissue_data.py

######## Simulation parameters ########
variable	number_cells	equal	900      # Updated to match initial_cells.data
variable	fraction	equal	1
variable    	cut_length_in   equal   20
variable	v0 		equal 	0.001
variable	pre_fac		equal	10
variable 	p0 		equal 	3.65
variable	Nbeads_large	equal	50
variable	num_dense	equal	1
variable     Dr 		equal 	1
variable     dt_integration  equal   0.001
variable     tau_c equal 1000

######## System setup ########
dimension	2
boundary	p p p
atom_style	molecular
neighbor	0.5 bin
units 		lj
timestep  	${dt_integration}

# Read pre-generated hexatic lattice configuration
read_data	initial_cells.data

fix     2D      all enforce2d

######################################### derived parameters
variable	Rank		equal	1000
variable	seed		equal	1000*${Rank}
variable	size_ratio	equal	1.4
variable	number_cells_large	equal	ceil(${number_cells}*${fraction})
variable	number_cells_small	equal	${number_cells}-${number_cells_large}

variable	Nbeads_large	equal	50
variable	Nbeads_small	equal	ceil(${Nbeads_large}/${size_ratio})

variable	RadiusLarge	equal	0.56
variable	RadiusSmall	equal	0.56/${size_ratio}

variable	area_small	equal	PI*${RadiusSmall}^2
variable	area_large	equal	PI*${RadiusLarge}^2
variable	perimeter_small	equal	2*PI*${RadiusSmall}
variable	perimeter_large	equal	2*PI*${RadiusLarge}
variable	lbond_small	equal	${perimeter_small}/${Nbeads_small}
variable	lbond_large	equal	${perimeter_large}/${Nbeads_large}

variable	RadLarge_shell	equal	${RadiusLarge}+${lbond_large}/2
variable	RadSmall_shell	equal	${RadiusSmall}+${lbond_large}/2
variable	area_cells	equal	PI*${RadLarge_shell}^2*${number_cells_large}+PI*${RadSmall_shell}^2*${number_cells_small}

######## setting needed for usage of bond_harmonic_area ########

compute Cells all chunk/atom molecule #### this compute must be called Cells
fix	AreaCell all property/atom d_area_cell ghost yes
fix	LengthBond all property/atom d_length_bond ghost yes
fix	KArea all property/atom d_k_area ghost yes
fix	theta_0 all property/atom d_theta_0 ghost yes
fix	FxActive all property/atom d_fx_active ghost yes
fix	FyActive all property/atom d_fy_active ghost yes
fix	Mag_F_Active all property/atom d_mag_factive ghost yes
fix     theta all property/atom d_theta ghost yes
fix     factive all property/atom d_factive ghost yes
fix     xc all property/atom d_xc ghost yes
fix     yc all property/atom d_yc ghost yes
fix	area all property/atom d_area ghost yes
fix	peri all property/atom d_peri ghost yes
fix     shape all property/atom d_shape ghost yes
fix	eps_atom all property/atom d_eps_atom ghost yes
fix     force_pair_x all property/atom d_force_pair_x ghost yes
fix     force_pair_y all property/atom d_force_pair_y ghost yes
fix     prop_dir all property/atom d_prop_dir ghost yes
fix	radius_curvature all property/atom d_radius_curvature ghost yes
fix	angle_curvature all property/atom d_angle_curvature ghost yes

group	MonomerLarge	molecule	1:${number_cells_large}
group	MonomerSmall	subtract	all MonomerLarge

### create different cell types
group Type1 molecule 1:${number_cells}
group Type2 subtract all Type1
set group Type1 type 1
# set group Type2 type 2  # Commented out: Type2 is empty (fraction=1) and type 2 doesn't exist in data file

### adjust cell parameters to incorporate rigidity with shape parameter p0
variable area_prefac equal ${perimeter_large}*${perimeter_large}/(${area_large}*${p0}*${p0})
variable modified_area_large equal ${area_prefac}*${area_large}
variable modified_area_small equal ${area_prefac}*${area_small}

##### Large & Small Cells: properties
variable	karea	equal	1000
set	group	MonomerLarge	d_area_cell   ${modified_area_large}
set	group	MonomerLarge	d_length_bond ${lbond_large}
set 	group	MonomerLarge	d_k_area	${karea}

set	group	MonomerSmall	d_area_cell ${modified_area_small}
set	group	MonomerSmall	d_length_bond ${lbond_small}
set 	group	MonomerSmall	d_k_area	${karea}

group border_cells type 1

##################################### set repulsive interaction before compression
variable M	equal 1.0
mass    *	$M

# interaction between beads of different cells
variable	dia	equal	${lbond_large}
variable	epsilon	equal	1.0/${Nbeads_large}

variable	eps11	equal	${epsilon}
variable        sigma11   equal   ${dia}*2^(-1.0/6)
variable        cut11     equal   ${dia}

pair_style lj/smooth/linear 2.5
pair_coeff      * * ${eps11} ${sigma11} ${cut11}
pair_modify shift yes

# particles of the same cell surface do not interact
neigh_modify exclude molecule/intra border_cells

######## bond between consecutive particles
variable	epsilon	equal	1.0/${Nbeads_large}
bond_style hybrid harmonic/area

variable	L_bond	equal	${lbond_large}
variable	K_bond	equal	1000000.0*${epsilon}
bond_coeff 	1 harmonic/area ${K_bond} ${L_bond}

# random direction of the self propelling directions
variable        two_pi  equal   2*PI
dump DUMPA all custom 1 mol_id.txt id mol
dump_modify DUMPA sort id
reset_timestep 0
run	1

undump	DUMPA
shell           ./random_propelling_directions.x ${number_cells_large} ${Nbeads_large} ${number_cells_small} ${Nbeads_small}
variable	thetafile atomfile self_propel_theta.txt
set             atom * d_theta v_thetafile
set		atom * d_theta_0 v_thetafile
set		atom * d_fx_active	0
set		atom * d_fy_active	0

fix	NVE	all nve

##### compute the occupied volume fraction
compute ac all property/atom d_area
variable area_cell atom c_ac
variable rad_eff atom (v_area_cell/PI)^0.5
variable delarea atom 1.1*v_rad_eff*${lbond_large}*PI
variable area_total atom v_area_cell+v_delarea

compute area_sum_large MonomerLarge reduce sum v_area_total
compute area_sum_small MonomerSmall reduce sum v_area_total

variable area_sum_large equal c_area_sum_large/v_Nbeads_large
variable area_sum_small equal c_area_sum_small/v_Nbeads_small
variable area_sum equal v_area_sum_large+v_area_sum_small
variable phi_real equal v_area_sum/vol

### compute occupied volume fraction from perimeter
compute pc all property/atom d_peri
variable peri_cell atom c_pc
variable delarea_p atom 1.1*${lbond_large}*v_peri_cell/2
variable area_total_p atom v_area_cell+v_delarea_p

compute area_sum_large_p MonomerLarge reduce sum v_area_total_p
compute area_sum_small_p MonomerSmall reduce sum v_area_total_p

variable area_sum_large_p equal c_area_sum_large_p/v_Nbeads_large
variable area_sum_small_p equal c_area_sum_small_p/v_Nbeads_small
variable area_sum_p equal v_area_sum_large_p+v_area_sum_small_p
variable phi_real_p equal v_area_sum_p/vol

thermo_style custom step temp pe ke etotal
thermo 100

reset_timestep 0

### this step compresses the system to the final density
# For hexatic lattice: maintain aspect ratio Ly/Lx = sqrt(3)/2
variable	aspect_hex	equal	sqrt(3)/2  # hexatic aspect ratio
variable	area_target	equal	${number_cells}/${num_dense}  # target area = 900
variable	Lx		equal	sqrt(${area_target}/${aspect_hex})  # Lx = 32.24
variable	Ly		equal	${Lx}*${aspect_hex}  # Ly = 27.92
variable	hl_x		equal	0.5*${Lx}
variable	ll_x		equal	-${hl_x}
variable	hl_y		equal	0.5*${Ly}
variable	ll_y		equal	-${hl_y}

fix COMPRESS all deform 1 x final ${ll_x} ${hl_x} y final ${ll_y} ${hl_y} remap x units box

dump DUMPA all custom 1000 /mnt/d/NextTissUe_data/compress_cells_propelled_NC${number_cells}_rho${num_dense}_att${pre_fac}_v${v0}_p0${p0}_dr${Dr}_tau${tau_c}.dat id x y mol fx fy d_xc d_yc d_area d_peri d_shape v_area_total
dump_modify DUMPA sort id
run	5000    # REDUCED: Compression (was 10000)
unfix	COMPRESS
run	10000   # REDUCED: Post-compression equilibration (was 100000)
undump	DUMPA
reset_timestep 0
############################################################################################################ make the interaction attractive

variable	dia	equal	${lbond_large}
variable	epsilon	equal	1.0/${Nbeads_large}

variable	eps11	equal	 ${epsilon}

variable        sigma11   equal   1.1*${dia}
variable        cut11     equal   0.1*${cut_length_in}*${dia}
variable    eps_wca equal   ${eps11}
variable	eps_att11	equal	${pre_fac}*${eps_wca}
variable    eps_att22   equal    ${eps_att11}/10
variable    eps_att12   equal   ${eps_att11}/20
set atom * d_eps_atom ${eps_att11}

variable visc equal 50
fix    viscous all viscous ${visc}

pair_style      wca/att ${cut11}
pair_coeff      1 1 ${eps_att11} ${sigma11} ${cut11} ${eps_wca}
# pair_coeff      2 2 ${eps_att22} ${sigma11} ${cut11} ${eps_wca}  # Type 2 doesn't exist (all cells are type 1)
# pair_coeff      1 2 ${eps_att12} ${sigma11} ${cut11} ${eps_wca}  # Type 2 doesn't exist (all cells are type 1)
neigh_modify exclude molecule/intra border_cells

####### activity settings
fix active all propel/cell cell ${v0} ${visc} ${tau_c} ${Dr} ${seed}

fix     cal_del_theta all property/atom d_theta2 ghost yes
set	atom * d_theta2 0

###########compute contact
compute f_pair_x all property/atom d_force_pair_x
compute f_pair_y all property/atom d_force_pair_y
compute x_unwrap all property/atom xu
compute y_unwrap all property/atom yu
compute com_x all property/atom d_xc
compute com_y all property/atom d_yc
variable rad_dot_f atom (c_x_unwrap-c_com_x)*c_f_pair_x+(c_y_unwrap-c_com_y)*c_f_pair_y
variable net_pair_f atom (c_f_pair_x^2+c_f_pair_y^2)^0.5
variable time equal step*${dt_integration}

#####compute shape index
compute q0_l MonomerLarge property/atom d_shape
compute q0_s MonomerSmall property/atom d_shape
compute mean_q0_large MonomerLarge reduce ave c_q0_l
compute mean_q0_small MonomerSmall reduce ave c_q0_s

variable Vmean_q0 equal " (c_mean_q0_large * v_number_cells_large + c_mean_q0_small * v_number_cells_small) / v_number_cells "
thermo_style custom step temp pe ke etotal press
thermo 100000

variable TEMP	equal temp
variable PRESS equal press
variable VOL equal vol
variable KE equal ke
variable E_TOT equal etotal
compute KE_atom all ke/atom

###############################################################################
# Microrheology test: Apply constant external force to two probe cells
###############################################################################

# Select two neighboring cells near left edge, center of y-axis
# Cells identified by find_probe_cells.py:
#   Cell 1: mol_id = 709, position = (1.50, 26.85)
#   Cell 2: mol_id = 710, position = (2.50, 28.58)
#   Distance: 2.000 LJ, Y-difference: 1.732 LJ
variable probe_mol_1 equal 709
# variable probe_mol_2 equal 710

group probe_cell_1 molecule ${probe_mol_1}
# group probe_cell_2 molecule ${probe_mol_2}

# Apply constant force in +x direction (0 degrees)
# Total force fd = 500.0, distributed over 50 beads per cell
variable fd equal 500.0
variable force_per_bead equal ${fd}/${Nbeads_large}  # fd/50 = 10.0

fix probe_force_1 probe_cell_1 addforce ${force_per_bead} 0.0 0.0
# fix probe_force_2 probe_cell_2 addforce ${force_per_bead} 0.0 0.0    # DISABLED: Only drag cell 1

# Track probe cell positions for analysis
compute probe1_com probe_cell_1 com
# compute probe2_com probe_cell_2 com                                  # DISABLED
variable probe1_x equal c_probe1_com[1]
variable probe1_y equal c_probe1_com[2]
# variable probe2_x equal c_probe2_com[1]                              # DISABLED
# variable probe2_y equal c_probe2_com[2]                              # DISABLED

# Update thermo output to include probe cell positions (only probe 1)
thermo_style custom step temp pe ke etotal press v_probe1_x v_probe1_y

###############################################################################
# Define groups for nearby cells at different distance shells
###############################################################################
# These groups track cells that will be affected by the probe cell drag
# First shell: 0-3 LJ (nearest neighbors)
# Second shell: 3-6 LJ (second neighbors)
# Third shell: 6-9 LJ (third neighbors)

group first_shell molecule 680 681 711 740 739 708 738
compute com_first_shell first_shell com

group second_shell molecule 682 741 769 768 737 652 712 770 767 653 683 742 771 799 798 797 736 766 713
compute com_second_shell second_shell com

group third_shell molecule 800 796 654 772 828 827 765 624 684 743 801 829 826 795 714 830 825 625 655 773 802 858 857 856 764 794
compute com_third_shell third_shell com

# Variables to track nearby cell COM positions
variable first_shell_x equal c_com_first_shell[1]
variable first_shell_y equal c_com_first_shell[2]
variable second_shell_x equal c_com_second_shell[1]
variable second_shell_y equal c_com_second_shell[2]
variable third_shell_x equal c_com_third_shell[1]
variable third_shell_y equal c_com_third_shell[2]

# Update thermo output to include nearby cell tracking (only probe 1)
thermo_style custom step temp pe ke etotal press v_probe1_x v_probe1_y v_first_shell_x v_first_shell_y v_second_shell_x v_second_shell_y v_third_shell_x v_third_shell_y

###############################################################################
# Main dynamics with microrheology probe
###############################################################################

run 5000    # REDUCED: Pre-measurement equilibration (was 100000)
reset_timestep 0

###############################################################################
# DISABLED: Specialized microrheology dumps (uncomment if needed)
###############################################################################
# dump MICRO_PROBE probe_cell_1 custom 100 /mnt/d/NextTissUe_data/microrheology_probe_NC${number_cells}_fd${fd}.dat id mol xu yu d_xc d_yc d_fx_active d_fy_active fx fy
# dump_modify MICRO_PROBE sort id append yes
# dump MICRO_PROBE2 probe_cell_2 custom 100 /mnt/d/NextTissUe_data/microrheology_probe2_NC${number_cells}_fd${fd}.dat id mol xu yu d_xc d_yc d_fx_active d_fy_active fx fy
# dump_modify MICRO_PROBE2 sort id append yes
# dump MICRO_FIRST first_shell custom 100 /mnt/d/NextTissUe_data/microrheology_first_shell_NC${number_cells}_fd${fd}.dat id mol xu yu d_xc d_yc fx fy d_area d_peri d_shape
# dump_modify MICRO_FIRST sort id append yes
# dump MICRO_SECOND second_shell custom 1000 /mnt/d/NextTissUe_data/microrheology_second_shell_NC${number_cells}_fd${fd}.dat id mol xu yu d_xc d_yc fx fy d_area d_peri
# dump_modify MICRO_SECOND sort id append yes
# dump MICRO_THIRD third_shell custom 1000 /mnt/d/NextTissUe_data/microrheology_third_shell_NC${number_cells}_fd${fd}.dat id mol xu yu d_xc d_yc fx fy d_area d_peri
# dump_modify MICRO_THIRD sort id append yes

###############################################################################
# Simple dump for OVITO visualization (all cells, all timesteps)
###############################################################################
# Output: atom positions, molecule ID, forces, cell center, cell properties
# Suitable for OVITO: positions + molecule coloring + cell tracking
dump OVITO_DUMP all custom 1000 /mnt/d/NextTissUe_data/ovito_cells_NC${number_cells}_fd${fd}.lammpstrj &
     id mol type x y xu yu d_xc d_yc d_area d_peri d_shape
dump_modify OVITO_DUMP sort id

run	3000000  # REDUCED: Main measurement run (was 20000001)

# Cleanup dumps
undump  OVITO_DUMP

jump SELF END

label END
